    "@upstash/redis": "^1.34.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.11",
    "lenis": "^1.1.14",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "next-auth": "^4.24.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.2.0",
    "tailwind-merge": "^2.5.4",
    "uploadthing": "^7.1.0",
    "@uploadthing/react": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
